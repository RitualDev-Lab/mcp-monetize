# ==============================================================================
# Model Context Protocol (MCP) Monetization Configuration
# ==============================================================================

# Dodo Payments Webhook Secret (from Dodo Payments Dashboard > Webhooks)
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_dodo_webhook_key_here

# Stripe Webhook Secret (from Stripe Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# HMAC Secret Key for Generating and Validating Signed License Tokens
LICENSE_SECRET_KEY=secret_tamper_proof_hmac_key_min_32_characters_here

# Storage Backend ('sqlite' or 'redis')
STORAGE_ADAPTER=sqlite

# SQLite Path (for Node 22+ built-in node:sqlite)
SQLITE_DB_PATH=./data/mcp-tokens.sqlite

# Redis Configuration (Optional, if using Upstash / Redis)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
